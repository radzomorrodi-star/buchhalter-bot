# ═══════════════════════════════════════════════════
# Telegram
# ═══════════════════════════════════════════════════
# Bot token from @BotFather
BOT_TOKEN=

# Your personal Telegram chat ID (numeric).
# The bot only accepts commands from this user.
OWNER_CHAT_ID=

# Optional: Channel where bons/receipts can be posted
CHANNEL_ID=

# Optional: Comma-separated Telegram usernames allowed
# to post receipts in CHANNEL_ID
CHANNEL_USERS=

# ═══════════════════════════════════════════════════
# LLM-Rotation (llm_router.py) — Smart-Fragen, OCR, Voice
# ═══════════════════════════════════════════════════
# Die Rotation probiert Provider der Reihe nach durch und faellt bei Fehler
# auf den naechsten zurueck. Damit IMMER ein LLM verfuegbar ist, sollte
# mindestens EIN API-Key-Provider gesetzt sein (kein Browser-Login noetig).
#
# Empfohlen: Groq (gratis, schnell) — garantiert den Fallback, falls der
# Claude-CLI-/Subscription-Login mal ablaeuft.
GROQ_API_KEY=

# Weitere optionale Provider (je mehr, desto robuster die Rotation):
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
# Anthropic: echter API-Key (sk-ant-api...) ODER per Subscription-CLI (claude).
# Ein OAuth-Token (sk-ant-oat...) gehoert in ANTHROPIC_AUTH_TOKEN und wird
# automatisch ueber die CLI genutzt (siehe fix_login.sh).
ANTHROPIC_API_KEY=

# Reihenfolge der Rotation (Komma-separiert). Default:
#   groq,anthropic,openai,gemini,deepseek,grok
# LLM_PROVIDER_ORDER=groq,anthropic,openai,gemini,deepseek,grok

# Optional: Keys stattdessen aus JSON-Datei laden ({"groq":"...", ...})
# LLM_KEYS_FILE=/opt/hoy/coding_bot/keys.json

# Alt/Abwaertskompatibel: LLM_API_KEY wird als Groq-Key akzeptiert.
LLM_API_KEY=

# ═══════════════════════════════════════════════════
# iCloud Calendar (optional)
# ═══════════════════════════════════════════════════
# Path to JSON with {"username": "...", "password": "app-specific-pwd"}
# CALDAV_CONFIG_PATH=~/.buchhalter-bot/caldav.json

# ═══════════════════════════════════════════════════
# Media Archive (optional)
# ═══════════════════════════════════════════════════
# Separater Bot der Media (Photos, Voices, Docs) im Log-Channel archiviert
MAIL_BOT_TOKEN=
MEDIA_ARCHIVE_CHANNEL_ID=
