# ═══════════════════════════════════════════════════
# Telegram
# ═══════════════════════════════════════════════════
# Bot token from @BotFather
BOT_TOKEN=

# Your personal Telegram chat ID (numeric).
# The bot only accepts commands from this user.
OWNER_CHAT_ID=

# Optional: Channel where bons/receipts can be posted
CHANNEL_ID=

# Optional: Comma-separated Telegram usernames allowed
# to post receipts in CHANNEL_ID
CHANNEL_USERS=

# ═══════════════════════════════════════════════════
# LLM for Smart-Questions & OCR (optional)
# ═══════════════════════════════════════════════════
# Compatible with any OpenAI-style API: Groq, OpenAI, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ═══════════════════════════════════════════════════
# iCloud Calendar (optional)
# ═══════════════════════════════════════════════════
# Path to JSON with {"username": "...", "password": "app-specific-pwd"}
# CALDAV_CONFIG_PATH=~/.buchhalter-bot/caldav.json

# ═══════════════════════════════════════════════════
# Media Archive (optional)
# ═══════════════════════════════════════════════════
# Separater Bot der Media (Photos, Voices, Docs) im Log-Channel archiviert
MAIL_BOT_TOKEN=
MEDIA_ARCHIVE_CHANNEL_ID=
